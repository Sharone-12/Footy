# FOOTYY Environment Variables Configuration

# PostgreSQL & Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

POSTGRES_URL=postgresql://...
POSTGRES_PRISMA_URL=postgresql://...
POSTGRES_URL_NON_POOLING=postgresql://...

# Streaming Providers
# DaddyLiveHD API Key (supports lowercase or uppercase in Vercel)
DADDYLIVE_API_KEY=your_daddylive_api_key
# daddylive_api_key=your_daddylive_api_key

# Live Dashboard Access Password (exclusively protects the /live section)
# Both variable names are supported across environments:
LIVE_ACCESS_PASSWORD=5589
live_password=5589
